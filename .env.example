# Copiez ce fichier en ".env" sur le serveur et remplissez-le. Ne le publiez JAMAIS.

# Clé secrète : générez-en une aléatoire (50+ caractères). Obligatoire en production.
SECRET_KEY=

# Production : False. (True uniquement sur votre ordinateur, pour développer)
DEBUG=False

# Votre domaine, séparés par des virgules, sans https://
ALLOWED_HOSTS=www.doumbia.shop,doumbia.shop
CSRF_TRUSTED_ORIGINS=https://www.doumbia.shop,https://doumbia.shop

# HTTPS (certificat SSL actif sur le domaine). Mettre False seulement tant qu'il n'y en a pas.
FORCE_HTTPS=True

# Chemin de l'admin Django (changez-le pour qu'il soit moins devinable)
ADMIN_URL=admin/

# Anti force brute : tentatives avant blocage, durée du blocage
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Mot de passe du 1er administrateur (commande seed). Sinon il est généré aléatoirement.
# SEED_ADMIN_PASSWORD=

# Synchronisation local -> cloud (optionnel)
# Instance LOCALE : CLOUD_SYNC_URL=https://mondomaine.com/api/sync/receive/ + SYNC_TOKEN
# Instance CLOUD  : SYNC_RECEIVE_ENABLED=True + le même SYNC_TOKEN (24+ caractères aléatoires)
CLOUD_SYNC_URL=https://doumbia.shop/api/sync/receive/
SYNC_TOKEN=e5f8u9a0b1c2h3e7f5a9b7c8k3e0f1z0
SYNC_RECEIVE_ENABLED=False
SYNC_INTERVAL_MINUTES=5
